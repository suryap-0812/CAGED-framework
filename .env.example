# Environment Configuration

# Application Settings
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings
DATABASE_URL=sqlite:///./caged.db
# DATABASE_URL=postgresql://caged_user:caged_pass@localhost:5432/caged_db

# Security & Pseudonymization
HASH_SALT=caged_default_secret_salt_2026

# Streaming Settings
WINDOW_SIZE_SECONDS=300
BUFFER_CAPACITY=10000

# False Alarm Control
TARGET_FALSE_ALARM_RATE=0.05

